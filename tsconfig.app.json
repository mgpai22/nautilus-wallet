{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue", "tests/**/*"],
  "exclude": ["src/**/__tests__/*", "tests/e2e/**/*", "tests/store/**/*", "node_modules"],
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "verbatimModuleSyntax": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@ergo-msig/core/nonce-store-suite": ["../ergo-msig/packages/core/test/support/nonce-store-suite.ts"],
      "@ergo-msig/core": ["../ergo-msig/packages/core/src/index.ts"],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "chrome", "w3c-web-usb"]
  }
}
